# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Needed by cron routes, the Microsoft connection and notifications.
SUPABASE_SERVICE_ROLE_KEY=

# --- Microsoft 365 (Entra app registration) ---------------------------------
# One app registration serves two purposes:
#  1. Application permission Sites.Selected (or Sites.Read.All) → reads the
#     master client list on SharePoint via client credentials.
#  2. Delegated permissions (User.Read, User.ReadBasic.All, Team.ReadBasic.All,
#     Channel.ReadBasic.All, ChannelMessage.Send, Mail.Send, offline_access) →
#     posts in Teams / sends Outlook mail as the account connected on
#     /admin/integrations. Add `${APP_URL}/api/microsoft/callback` as a Web
#     redirect URI.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Optional: point at a different workbook (defaults are the admin-team file).
GRAPH_CLIENT_LIST_DRIVE_ID=
GRAPH_CLIENT_LIST_ITEM_ID=

# Public URL of this deployment; used for OAuth redirects and links in notices.
APP_URL=https://crm.kolteassociates.in

# Shared secret for /api/cron/* (Vercel Cron sends it automatically).
CRON_SECRET=

# --- Periskope (WhatsApp) — optional ----------------------------------------
PERISKOPE_API_KEY=
# Connected org phone in country-code format, e.g. 919876543210
PERISKOPE_PHONE=
# PERISKOPE_API_URL=https://api.periskope.app/v1

# --- Nextel WhatsApp templates (client reminders) ---------------------------
NEXTEL_SEND_URL=
NEXTEL_API_KEY=
ITR_TEMPLATE_MEDIA=

# --- Yeastar PBX click-to-call — optional ------------------------------------
YEASTAR_CLIENT_ID=
YEASTAR_CLIENT_SECRET=
YEASTAR_PBX_DOMAIN=
YEASTAR_PORT=
YEASTAR_DIAL_PREFIX=
